# bootstrap.env.example — copy to bootstrap.env and fill in.
# This single file feeds every subsystem in `scripts/bootstrap.sh`.

# ─── Identity ───────────────────────────────────────────────────────────────
PARENT_DOMAIN=insaneaiautomation.xyz
ACME_EMAIL=you@insaneaiautomation.xyz
TIMEZONE=Europe/Berlin

# ─── Public hostnames (each must be a subdomain of PARENT_DOMAIN) ──────────
N8N_HOST=n8n.insaneaiautomation.xyz
CRM_HOST=crm.insaneaiautomation.xyz
NOCODB_HOST=sheets.insaneaiautomation.xyz
GRAFANA_HOST=metrics.insaneaiautomation.xyz

# ─── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_USER=stackadmin
POSTGRES_PASSWORD=  # `openssl rand -hex 24`

# ─── n8n ────────────────────────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=  # `openssl rand -hex 32`
N8N_API_URL=https://${N8N_HOST}
N8N_API_KEY=  # generate in n8n Settings → n8n API after first boot, then re-run bootstrap

# ─── Twenty ─────────────────────────────────────────────────────────────────
TWENTY_APP_SECRET=  # `openssl rand -hex 32`

# ─── MinIO ──────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=stackadmin
MINIO_ROOT_PASSWORD=  # `openssl rand -hex 24`

# ─── Browserless ────────────────────────────────────────────────────────────
BROWSERLESS_TOKEN=  # `openssl rand -hex 24`

# ─── Grafana ────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=  # `openssl rand -hex 16`

# ─── Tailscale (https://login.tailscale.com/admin/settings/keys — Reusable, no expiry) ───
TAILSCALE_AUTHKEY=tskey-auth-...

# ─── Cloudflare (https://dash.cloudflare.com/profile/api-tokens — Zone:DNS:Edit + Account:Email Routing:Edit + Account:Workers Scripts:Edit) ───
CF_API_TOKEN=
CF_ZONE_ID=  # from the Cloudflare zone overview page
CF_ACCOUNT_ID=  # from the Cloudflare account dashboard

# Address that bounced/replied mail forwards to (your real inbox; CF Email Routing requires
# at least one verified destination before it'll forward to Workers).
CF_VERIFIED_DESTINATION=you@gmail.com

# ─── Oracle Always-Free VM ──────────────────────────────────────────────────
ORACLE_SSH_USER=ubuntu
ORACLE_SSH_HOST=  # public IP of the Oracle VM
ORACLE_SSH_KEY=~/.ssh/oracle_postal_rsa  # private key path

# ─── Sourcing engines (innovation #11) — all optional; missing = engine disabled ───
# Twitter: throwaway X accounts for twscrape (set after `twscrape accounts add`)
# Farcaster: free Neynar dev tier at https://dev.neynar.com
NEYNAR_API_KEY=
# Reddit: free script app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=local-email-stack/4.0
# GitHub: PAT with public read scope (raises rate limit 60→5000/hr)
GITHUB_TOKEN=
# Instagram throwaway account
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
# Product Hunt: free dev token at https://api.producthunt.com/v2/docs
PRODUCTHUNT_TOKEN=

# ─── Smart-routing free transactional providers (innovation #3) ────────────
# All optional — if blank, only Postal is used.
BREVO_API_KEY=
MAILERSEND_API_KEY=
SENDPULSE_USER_ID=
SENDPULSE_SECRET=

# ─── Federated suppressions (innovation #10) ───────────────────────────────
SUPPRESSION_FEDERATION_ENABLED=true
SUPPRESSION_FEDERATION_SALT=  # `openssl rand -hex 32` — keep stable forever

# ─── Personas (innovation #5) ──────────────────────────────────────────────
# personas.yaml in scripts/ defines all 10 personas. Bootstrap regenerates DKIM-aware
# signatures matching each persona's subdomain on first run.
