# Copy to supabase.env (gitignored). Get values from:
#   Supabase Dashboard → Settings → API
#
# - SUPABASE_URL: "Project URL"  (e.g. https://abcdef12345.supabase.co)
# - SUPABASE_ANON_KEY: "anon public" key (long JWT-like string)
#
# These two values are also pasted into the desktop app (Settings → Sync) so the
# UI reads cross-PC state in real time.

SUPABASE_URL=
SUPABASE_ANON_KEY=
