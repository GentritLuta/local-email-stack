# Copy to youtube.env (gitignored) and fill in:
#
# Generate at https://console.cloud.google.com/apis/credentials
#   - create project (or pick existing), enable "YouTube Data API v3"
#   - create credentials → API key → restrict to "YouTube Data API v3"
#
# Free tier: 10,000 quota units/day per project. Each channel-About
# lookup costs 1 unit; each search request costs 100 units.
#
# MULTI-KEY (recommended for multi-client scale): register a separate
# GCP project per client niche and add their API key as YOUTUBE_API_KEY_N.
# The async worker rotates through them and pools quota together.
# 5 keys = 50k/day = ~25k channels probed/day = 1500-2500 emails/day.
#
# Either single-key format:
#   YOUTUBE_API_KEY=AIza...
#
# Or multi-key format:
#   YOUTUBE_API_KEY_1=AIza...
#   YOUTUBE_API_KEY_2=AIza...
#   YOUTUBE_API_KEY_3=AIza...

YOUTUBE_API_KEY=
