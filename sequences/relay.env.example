# relay.env.example
# Copy to relay.env (in this same directory) and fill in ONE backend's section.
# Never commit relay.env.

# ─── Backend 1: Resend (recommended for fastest inbox placement) ───────────
# 1. Sign up: https://resend.com (free, no credit card)
# 2. Verify your sending domain (DNS records auto-generated; paste into Cloudflare)
# 3. Create an API key → paste below
RESEND_API_KEY=

# ─── Backend 2: Generic SMTP relay (Gmail / Outlook / any) ─────────────────
# Gmail:    SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
#           SMTP_USER=you@gmail.com, SMTP_PASS=<App Password from accounts.google.com/apppasswords>
# Outlook:  SMTP_HOST=smtp-mail.outlook.com, SMTP_PORT=587
#           SMTP_USER=you@outlook.com, SMTP_PASS=<App Password>
# Hostinger:SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465 (SSL) or 587 (STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Backend 3: Self-hosted Postal on Oracle Cloud Free Tier ───────────────
# Set up per SENDER_INFRA.md. Reached over Tailscale.
POSTAL_SMTP_HOST=postal-mail
POSTAL_SMTP_PORT=587
POSTAL_SMTP_USER=
POSTAL_SMTP_PASS=
