# Copy to twitch.env (gitignored) and fill in.
#
# Get credentials at https://dev.twitch.tv/console/apps
#   1. Log in with any Twitch account (no special tier required, all free)
#   2. "Register Your Application" — pick any name
#   3. OAuth redirect URLs: http://localhost (we use client_credentials flow,
#      so this is unused but required by the form)
#   4. Category: "Application Integration"
#   5. Confidential: yes
#   6. Copy Client ID and (after clicking "New Secret") the Client Secret
#
# Free tier: 800 requests/minute. No daily cap. Helix API stays in this
# limit at all reasonable scraping rates.
#
# Then run:
#   py sequences/social_scrape.py twitch crypto_influencer <handles_file>

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
