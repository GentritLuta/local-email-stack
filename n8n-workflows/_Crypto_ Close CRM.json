                                         "jsCode":  "const raw = $json.phone || \"\";\n\n// Remove everything except digits\nconst digits = raw.replace(/\\D/g, \"\");\n\n// Force US format\nlet formatted = digits;\n\nif (digits.length === 10) {\n  formatted = \"+1\" + digits;\n} else if (digits.length === 11 \u0026\u0026 digits.startsWith(\"1\")) {\n  formatted = \"+\" + digits;\n} else {\n  formatted = \"+\" + digits; // fallback\n}\n\nreturn [\n{\n  json: {\n    ...$json,\n    phone: formatted\n  }\n}\n];"
