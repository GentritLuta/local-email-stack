                      "parameters":  {
                                         "jsCode":  "// Get full name from possible fields\nconst fullName = $json.personName || $json.name || $json.owner || \"\";\n\n// Split name\nconst parts = fullName.trim().split(/\\s+/);\nconst firstName = parts.shift() || \"\";\nconst lastName = parts.join(\" \") || \"\";\n\n// Get city/state string from possible fields\nconst location = $json.location || $json.cityState || $json.formatted_address || \"\";\n\n// Split city and state\nlet city = \"\";\nlet state = \"\";\n\nif (location.includes(\",\")) {\n  const locationParts = location.split(\",\");\n  city = locationParts[0].trim();\n  state = locationParts[1].trim();\n}\n\nreturn [\n  {\n    json: {\n      ...$json,\n      firstName: firstName,\n      lastName: lastName,\n      city: city,\n      state: state\n    }\n  }\n];"
                                     },
