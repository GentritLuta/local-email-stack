  "rotation": {
    "strategy": "round_robin_by_persona",
    "max_sends_per_persona_per_day": 30,
    "min_seconds_between_sends_same_persona": 180,
    "_comment": "Capped at 2/persona × 10 personas = 20/day for first week. send_ramp below auto-scales this up."
  },
  "send_ramp": {
    "_doc": "Per-profile new-sender ramp. The sequence-runner reads max_per_persona_today() from this curve at every tick. Even though our 10 subdomains are mature (shared from Aureon), the FROM addresses (tomas@, sara@...) are new identities and need their own warmup so ISPs trust them. Curve hits 20/persona × 10 personas = 200/day target on day 22.",
    "started_at": "2026-05-18",
    "curve": [
      {
        "from_day": 1,
        "per_persona": 1
      },
      {
        "from_day": 4,
        "per_persona": 3
      },
      {
        "from_day": 8,
        "per_persona": 5
      },
      {
        "from_day": 15,
        "per_persona": 10
      },
      {
        "from_day": 22,
        "per_persona": 20
      }
    ]
  },
