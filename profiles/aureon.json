  "_architecture_note": [
    "Per-persona reputation isolation: each persona sends from a unique address on a",
    "dedicated subdomain (mail.aureonglobal.de) verified at Resend. No Hostinger mailbox",
    "is required behind these From: addresses because Resend owns the SMTP egress.",
    "Replies route back via Hostinger's normal MX on aureonglobal.de — the user adds an",
    "ImprovMX-style forwarder (or Cloudflare Email Routing) on mail.aureonglobal.de later",
    "if they want replies to a different inbox; for now Reply-To = info@aureonglobal.de."
  ],

  "relay": {
    "backend": "resend",
    "from_domain": "mail.aureonglobal.de",
