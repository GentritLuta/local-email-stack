# Copy to .env and fill in. Never commit .env.

ACME_EMAIL=you@example.com
TIMEZONE=Europe/Berlin

# The parent domain you already own. Sender subdomains m1..m10 will live under it.
SENDER_PARENT_DOMAIN=insaneaiautomation.xyz

# Postgres
POSTGRES_USER=stackadmin
POSTGRES_PASSWORD=change-me-long-random

# n8n
N8N_ENCRYPTION_KEY=change-me-32-bytes-random
N8N_HOST=n8n.yourdomain.tld

# CRM
CRM_HOST=crm.yourdomain.tld
TWENTY_APP_SECRET=change-me-random

# Sheets-replacement
NOCODB_HOST=sheets.yourdomain.tld

# MinIO
MINIO_ROOT_USER=stackadmin
MINIO_ROOT_PASSWORD=change-me-long-random

# Browserless (Chromium pool used by scraper)
BROWSERLESS_TOKEN=change-me-random

# Grafana
GRAFANA_HOST=metrics.yourdomain.tld
GRAFANA_ADMIN_PASSWORD=change-me

# Tailscale — connects home server to the Oracle Postal VM
# Create an auth key at https://login.tailscale.com/admin/settings/keys (free)
TAILSCALE_HOSTNAME=home-email-stack
TAILSCALE_AUTHKEY=tskey-auth-...

# Cloudflare Tunnel (optional alternative to Traefik public exposure)
# CLOUDFLARED_TOKEN=eyJ...
