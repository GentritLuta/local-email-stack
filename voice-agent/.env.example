# Copy to .env on the RTX box. The RTX path keeps everything local except telephony.

# --- Supabase (reuse the stack's project; SERVICE key so it can read leads + log) ---
SUPABASE_URL=https://zmzolkijhiaedzcmdfji.supabase.co
SUPABASE_SERVICE_KEY=            # service_role JWT (same as sequences/supabase.env)

# --- Telephony: Telnyx (cheapest, ~$0.002/min). Human hands over a number + key ---
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=            # Voice API / SIP connection that bridges to the agent
TELNYX_FROM_NUMBER=              # +1... the caller ID you own and have registered

# --- Local models on the RTX (free path) ---
WHISPER_MODEL=base.en           # faster-whisper size (base.en is plenty for phone audio)
OPENAI_BASE_URL=http://localhost:11434/v1   # Ollama/vLLM OpenAI-compatible endpoint
OPENAI_API_KEY=local            # dummy for local endpoints
LLM_MODEL=llama3.1:8b-instruct  # whatever you serve locally

# --- Voice cloning (Chatterbox, local) ---
CLONE_REFERENCE_WAV=voice-agent/voices/agent_sample.wav   # 10-30s clean sample to clone
AGENT_NAME=Alex
AGENCY_NAME=Aureon
LOCAL_AGENT_NAME=Andrew

# --- Managed fallback (only if NOT self-hosting TTS/STT on the RTX) ---
# CARTESIA_API_KEY=
# DEEPGRAM_API_KEY=
